<mxCell id="n1" value="Ogni servizio verifica lo stato di partenza dell'appuntamento prima di cambiarlo: BOOKED per completare o annullare, COMPLETED per fatturare, INVOICED per refertare. Una transizione non prevista produce una risposta 409." style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="300" height="96" as="geometry"/></mxCell>
<mxCell id="n2" value="AuditAspect intercetta i metodi annotati con @Audited di tutti i servizi (prenotazione, visita, fattura, referto, deleghe) e registra l'esito anche quando la transazione viene annullata." style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="740" height="46" as="geometry"/></mxCell>
